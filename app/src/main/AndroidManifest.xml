<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network access for Kaspa node connections -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Push notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Camera (optional): scanning QR codes - addresses, payment requests and Cold Storage
         signing. KaChat Wallet has no calls and no voice messages, so no microphone, audio
         routing or call foreground service (iOS wallet 964fb25, a11a6d7). -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Saving a received photo message to the device gallery. Only needed on API 28 and below —
         API 29+ (Q) scoped storage lets MediaStore inserts succeed without this permission. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <!-- Vibration for notification feedback -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Biometric/device-credential prompt guarding the seed phrase and account unlock -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Play derives REQUIRED hardware from the permissions above unless it is told otherwise:
         CAMERA implies android.hardware.camera. Left implicit, the store hides the app from every
         device without one - most Chromebooks, camera-less tablets, TV/auto form factors - though
         the camera is an optional extra (QR scanning). Declaring it required="false" keeps the app
         installable there; scanning already checks for it at runtime. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- usesCleartextTraffic stays true DELIBERATELY (2026-08 security audit, decision 3A):
         Kaspa node gRPC (protowire on port 16110/16210) is plaintext by protocol, and a
         networkSecurityConfig cannot scope a cleartext allowance by port — only by domain —
         which is useless for a pool of bare peer IPs. grpc-okhttp builds its own sockets and
         does not reliably consult the platform's cleartext policy anyway, so tightening the
         flag would only give a false sense of coverage. Everything HTTP in the app (indexer,
         KNS, REST API, push registration, Nextcloud, link previews) is https-only at the
         application layer instead: the URL settings fields are read-only, and the one
         user-editable server input (Nextcloud) rejects explicit http:// in the UI and again in
         NextcloudService.normalizeServer. -->
    <application
        android:name=".KaChatApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.KaChat"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.KaChat"
            android:resizeableActivity="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- kapay://pay/<address>?... (the same tail as kachat://pay/) is how KaPost and KaChat
                 hand a payment request over: Send Kaspa opens filled in. kachatwallet:// is its
                 name from before KaPay, still accepted (iOS wallet d9bec97). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="kapay" />
                <data android:scheme="kachatwallet" />
            </intent-filter>
            <!-- No kachat:// or https://kachat.app links and no share target: those open KaChat,
                 whose chats, posts and rooms they lead to, and KaPay has none (iOS wallet
                 registers no associated domains, and dd35458 dropped its chat Shortcuts). -->
        </activity>

        <!-- WorkManager's default auto-init is disabled — KaChatApplication implements
             Configuration.Provider so SyncWorker gets constructed via HiltWorkerFactory
             (see SyncWorker.kt) instead of a no-arg constructor. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Lets the chat-history export share a plaintext JSON file from app-private cache via a content:// URI, without granting broad file access. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- FCM Push Notification Service. Data-only messages are handled here and turned into
             notifications via NotificationHelper (mirrors iOS's Notification Service Extension).
             Inactive at runtime until google-services.json is added (see app/build.gradle.kts). -->
        <service
            android:name=".services.KaChatFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Default notification channel for FCM (used if a message arrives without an explicit
             channel). Points at the app's primary messages channel. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="kachat_messages_sound_vibrate" />
        <!-- The push service's "Received" push is a notification message, which Android draws
             itself while the app is in the background: with the wallet's status-bar icon, not
             the full-colour launcher icon (PUSH_SERVICE.md). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_kachat_wallet_notification" />

        <!-- Required for AppCompatDelegate.setApplicationLocales() to survive a cold app
             restart on API <33 (the Settings > Language row uses this API) - without this
             meta-data entry, the per-app language backport can't auto-restore the saved
             locale on the next launch. No-op on API 33+, which has native per-app language
             support and ignores this. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

    </application>

</manifest>
